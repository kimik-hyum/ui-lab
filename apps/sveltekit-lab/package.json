{
  "name": "sveltekit-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "svelte-kit sync && vite dev --host 127.0.0.1 --port 3002",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3002",
    "lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.53.0",
    "@tanstack/svelte-query": "^6.1.33",
    "@ui-lab/api-types": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^7.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
